-- Create the UPI table
CREATE TABLE UPI (
    upi_payment_id INT IDENTITY(1,1) PRIMARY KEY,
    pid INT UNIQUE NOT NULL,                  -- Links to Payment table, UNIQUE as one payment has one UPI record
    upi_id VARCHAR(100) NOT NULL,             -- e.g., yourname@bankname
    transaction_id VARCHAR(100) NULL,         -- UPI Transaction ID from payment gateway
    payment_timestamp DATETIME DEFAULT GETDATE() -- Timestamp of the actual UPI transaction
);

-- Add Foreign Key Constraint to UPI table
ALTER TABLE UPI
ADD CONSTRAINT FK_UPI_Payment FOREIGN KEY (pid) REFERENCES Payment(pid);


-- Create the Cards table
CREATE TABLE Cards (
    card_payment_id INT IDENTITY(1,1) PRIMARY KEY,
    pid INT UNIQUE NOT NULL,                  -- Links to Payment table, UNIQUE as one payment has one Card record
    card_number_masked VARCHAR(20) NOT NULL,  -- Store only last 4 digits (e.g., 'XXXX-XXXX-XXXX-1234')
    card_holder_name VARCHAR(100) NOT NULL,
    expiry_month CHAR(2) NOT NULL,            -- Store as MM (e.g., '01', '12')
    expiry_year CHAR(4) NOT NULL,             -- Store as YYYY (e.g., '2025')
    card_type VARCHAR(10) NOT NULL CHECK (card_type IN ('Debit', 'Credit')), -- 'Debit' or 'Credit'
	card_cvv CHAR(3) NOT NULL,
    transaction_id VARCHAR(100) Null,         -- Transaction ID from payment gateway
    payment_timestamp DATETIME DEFAULT GETDATE() -- Timestamp of the actual card transaction
);

-- Add Foreign Key Constraint to Cards table
ALTER TABLE Cards
ADD CONSTRAINT FK_Cards_Payment FOREIGN KEY (pid) REFERENCES Payment(pid);


