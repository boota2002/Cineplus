@model CinePlus.Models.Movie
@if (ViewBag.movie!= null)
{
    <div class="alert alert-success alert-dismissible mx-auto" style="margin-top:200px;max-width:600px">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <strong>@ViewBag.movie</strong>
    </div>
}
@if (ViewBag.movieexist!= null)
{
    <div class="alert alert-danger alert-dismissible mx-auto" style="margin-top:200px;max-width:600px">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <strong>@ViewBag.movieexist</strong>
    </div>
}

<div class="container mx-auto shadow-lg py-4 px-5" style="margin-top:200px;max-width:600px;">
    <h1 class="text-center">Add Movie</h1>
    <form method="post" enctype="multipart/form-data">
        <input type="text" name="moviename" class="form-control" placeholder="Enter Movie Name" />
        <select name="genname" class="form-select mt-3">
            <option value="">Select Genre</option>
            @foreach (var gen in ViewBag.Genre)
            {
                <option value="@gen.GenreId">@gen.Name</option>
            }
        </select>
        <input type="text" name="duration" class="form-control mt-3" placeholder="Enter Movie Duration"/>
        <input type="text" name="des" class="form-control mt-3" placeholder="Enter Movie Description" />
        <input type="date" name="rdate" class="form-control mt-3" />
        <input type="text" name="actor" class="form-control mt-3" placeholder="Enter Movie Actor Name"/>
        <input type="text" name="actress" class="form-control mt-3" placeholder="Enter Movie Actress Name" />
        <input type="text" name="director" class="form-control mt-3" placeholder="Enter Movie Director Name" />
        <input type="text" name="producer" class="form-control mt-3" placeholder="Enter Movie Producer Name" />
        <input type="text" name="musician" class="form-control mt-3" placeholder="Enter Movie Musician Name" />
        <input type="file" name="poster" accept="image/*" class="form-control mt-3" />
        <input type="submit" value="Add Movie" class="btn btn-primary w-100"/>
    </form>
</div>