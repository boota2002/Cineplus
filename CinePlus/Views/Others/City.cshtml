
@model CinePlus.Models.City

@if (ViewBag.city != null)
{
    <div class="alert alert-success alert-dismissible mx-auto" style="margin-top:200px;max-width:600px">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <strong>@ViewBag.city</strong>
    </div>
}
@if (ViewBag.cityexist!=null)
{
    <div class="alert alert-danger alert-dismissible mx-auto" style="margin-top:200px;max-width:600px">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <strong>@ViewBag.cityexist</strong>
    </div>
}
<div class="container mx-auto shadow-lg py-4 px-5" style="margin-top:200px;max-width:600px; max-height:400px">
    <h1 class="text-center">City Page</h1>
    <form method="post">
        <input asp-for="CityName" type="text" name="city" value="" placeholder="Enter City Name" class="form-control" />
        <span asp-validation-for="CityName" class="text-danger"></span>
        
        <input type="submit" value="Add City" class="btn btn-primary mt-3 w-100" />
    </form>
</div>