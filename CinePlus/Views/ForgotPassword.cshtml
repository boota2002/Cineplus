@model CinePlus.Models.User
<br />
<br />
<div class="class container-fluid shadow" style="width:400px; align-items:center; align-self:center;">
    <form method="post" style="text-align:center">
        <h1 class="justify-content-center">Forgot Password</h1><br />
        <input type="text" asp-for=Email placeholder="Email" required pattern="^[a-zA-z0-9]+$" class="form-control" /><br /><br />
        <select asp-for=SecurityQuestion placeholder="Security Question" class="form-control">
            <option>select</option>
            <option>favourite food</option>
            <option>favourite place</option>
            <option>favourite movie</option>
            <option>favourite hero</option>
        </select> <br /> <br />
        <input type="text" asp-for=SecurityAnswer required placeholder="Security Answer" class="form-control" /><br /><br />
        <input type="text" asp-for=Pass placeholder="Password" class="form-control" /><br /><br />
        <input type="text" name="confirmpass" placeholder="Confirm Password" class="form-control" /><br /><br />

        <div style="width:fit-content;">
            <input type="submit" value="Change Password" class="btn btn-outline-primary" />
        </div><br /><br />
    </form><br /><br /><br />
</div>
<div color="red">@ViewBag.err</div>
<div>@ViewBag.update</div>