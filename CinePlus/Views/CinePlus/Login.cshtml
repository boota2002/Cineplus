@model CinePlus.Models.User
@{
}
<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg" style="width: 450px; border: none; background: linear-gradient(145deg, #3c3c3c, #2d2d2d);">
        <div class="card-header bg-dark text-white text-center py-3">
            <h3 class="mb-0"><i class="bi bi-film me-2"></i>Login</h3>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label text-white"><i class="bi bi-person-fill me-2"></i><b>Username</b></label>
                    <input asp-for="Username" name="username" type="text" class="form-control bg-dark text-white border-dark" placeholder="Enter your username" required />
                </div>
                <div class="mb-3">
                    <label class="form-label text-white"><i class="bi bi-lock-fill me-2"></i><b>Password</b></label>
                    <input asp-for="Pass" name="pass" type="password" class="form-control bg-dark text-white border-dark" placeholder="Enter your password" required />
                </div>
                <div class="mb-4">
                    <label class="form-label text-white"><i class="bi bi-shield-lock me-2"></i><b>CAPTCHA Verification</b></label><br />
                    @if (ViewBag.CaptchaImage != null)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <img src="@ViewBag.CaptchaImage" alt="CAPTCHA Image" class="img-fluid rounded border border-secondary ms-2" style="height: 40px;" />
                            <button type="button" onclick="window.location.reload()" class="btn btn-sm btn-outline-light ms-2">
                                <large>🔄</large>
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="text-warning">CAPTCHA not available. Please refresh.</p>
                    }
                    <input type="text" name="captchaText" class="form-control bg-dark text-white border-dark" placeholder="Enter CAPTCHA" required />
                </div>
                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-success btn-lg fw-bold">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                    </button>
                </div>
                <div class="text-sm-start text-white">
                    <span>
                        If forgot password<a href="@Url.Action("ForgotPassword")" class="text-info text-decoration-none">
                            <i>Click here</i>
                        </a>to reset.
                    </span>
                </div>
            </form>
            @if (ViewBag.err != null)
            {
                <div class="alert alert-warning mt-3 mb-0 d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span>@ViewBag.err</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* body { */
    /*     background-color: #121212; */
    /* } */

    .card {
        border-radius: 10px;
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .form-control 
    {
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .form-control:focus 
        {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            background-color: #1a1a1a;
        }

    .btn-success {
        background-color: #28a745;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            background-color: #218838;
            transform: translateY(-2px);
        }
</style>
