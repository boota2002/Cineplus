@{
    // Add your logo image path here, e.g., ~/images/logo.png
    var logoPath = Url.Content("~/images/logo.png");
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        nav {
            background-color: white;
            padding: 20px;
            font-size: large;
        }

            nav a.dark {
                color: black;
                text-decoration: none;
                margin-right: 4px;
                font-weight: 500;
                padding: 15px;
                border-radius: 4px;
            }

                nav a.dark:hover, nav a.dark:focus {
                    text-decoration: underline;
                    text-decoration-thickness: 3px;
                    text-decoration-color: #F1C202;
                }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div>
        <header>
            <nav class="shadow-sm">
                @{
                    <div style="display:flex; justify-content:space-between; align-items:center; width:100%;">
                        <div style="display:flex; align-items:center;">
                            <img src="/logo.png" alt="Logo" style="height:50px; width:auto;" />
                            <div style="display:flex; align-items:center; margin-inline-start:500px">
                                <a href="@Url.Action("Home","CinePlus")" class="dark">Home</a>
                                <a href="@Url.Action("Login","CinePlus")" class="dark">Login</a>
                                <a href="@Url.Action("Register","CinePlus")" class="dark">Register</a>
                                <a href="@Url.Action("Movies","CinePlus")" class="dark">Movies</a>
                                <a href="@Url.Action("UpdateProfile","CinePlus")" class="dark">Update Profile</a>
                            </div>
                            <a href="@Url.Action("MyTickets","CinePlus")"><img src="/ticket.png" style="width:20px;height:20px;" /></a>
                        </div>
                        @{
                            string d;
                            if (Context.Session.GetString("Username") == null)
                            {
                                d = "none";
                            }
                            else
                            {
                                d = "block";
                            }
                        }
                        <div style="display:flex; align-items:center;">
                            <form method="post" action="@Url.Action("Movies","CinePlus")">
                                <div>
                                    <a href="@Url.Action("LogOut","CinePlus")" class="btn btn-warning" style="color:black;display:@d">Log Out</a>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </nav>
        </header>
        @RenderBody()
        <footer>
        </footer>
    </div>
    
        @RenderSection("Scripts", required: false)


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>