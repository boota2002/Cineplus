<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        ul li a {
            color: black !important;
            font-size: large !important;
        }

        li a:hover {
            color: gold !important;
        }

        .logout {
            background: gold !important;
            color: black !important;
        }

        .btn {
            font-size: 18px !important;
            padding: 5px 10px !important;
        }
    </style>
</head>
<body>
    @* navbar code *@
    <nav class="navbar navbar-expand-sm  bg-white fixed-top shadow">
        <div class="container-fluid">
            <a class="navbar-brand  text-black" href="@Url.Action("Home", "Admin")"><img src="/images/logo.png" class="img-fluid" width="200" /></a>
            <button class="navbar-toggler bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mynavbar">
                <span class="navbar-toggler-icon "></span>
            </button>
                <div class="d-flex">
                    <h6 class="me-4">Welcome Admin</h6>
                </div>
                @{
                    string d;
                    if (Context.Session.GetString("user") == null)
                    {
                        d = "none";
                    }
                    else
                    {
                        d = "block";
                    }
                }
                <div><a href="@Url.Action("Logout", "CinePlus")" class="nav-link btn btn-sm logout" style="display:@d">Logout</a></div>
            </div>
        </div>
    </nav>

    <div class="my-3 py-3">
        @RenderBody()
    </div>


    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"> </script>


</body>
</html>
