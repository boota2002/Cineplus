<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css"/>  
    <style>
        ul li a{
            color: black !important;
            font-size: large !important;
            
        }
        li a:hover{
            color: gold !important;
        }
        .logout{
            background: gold !important;
            color: black !important;
        }
     .btn{
         font-size:18px !important;
         padding: 5px 10px !important;
        
     }
      
    </style>
</head>
<body>
    @* navbar code *@
    <nav class="navbar navbar-expand-sm  bg-white fixed-top shadow">
        <div class="container-fluid">
            <a class="navbar-brand  text-black" href="@Url.Action("Index", "Admin")"><img src="/images/logo.png" class="img-fluid" width="200"/></a>
            <button class="navbar-toggler bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mynavbar">
                <span class="navbar-toggler-icon "></span>
            </button>
            <div class="collapse navbar-collapse" style="margin-left:450px" id="mynavbar">
                <ul class="navbar-nav me-auto">
                    <li><a href="@Url.Action("Home", "Admin")" class="nav-link">Home</a></li>
                    <li>
                        <div class="dropdown ">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Movies</a>
                        <ul class="dropdown-menu">
                            <li><a href="@Url.Action("AddMovie", "Admin")" class="nav-link dropdown-item">Add Movie</a></li>
                            <li><a href="@Url.Action("AddMovieToTheater", "Admin")" class="nav-link dropdown-item">Add MovieTo Theater</a></li>
                            <li><a href="@Url.Action("UpdateMovie", "Admin")" class="nav-link dropdown-item">Update Movie</a></li>
                            <li><a href="@Url.Action("DeleteMovie", "Admin")" class="nav-link dropdown-item">Delete Movie</a></li>
                        </ul>
                        </div>
                    </li>
                    <li>
                        <div class="dropdown ">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Others</a>
                            <ul class="dropdown-menu">
                                <li><a href="@Url.Action("Genre", "Others")" class="nav-link dropdown-item">Add Genre</a></li>
                                <li><a href="@Url.Action("City", "Others")" class="nav-link dropdown-item">Add City</a></li>
                                <li><a href="@Url.Action("AddTheater", "Others")" class="nav-link dropdown-item">Add Theater</a></li>
                                <li><a href="@Url.Action("AddLanguage", "Others")" class="nav-link dropdown-item">Add Languages</a></li>
                            </ul>
                        </div>
                    </li>
                  
                </ul>
                
               
          
                <div class="d-flex">
                    <h6 class="me-4">Welcome Admin</h6>
                </div>
                @{
                    string d;
                    if (Context.Session.GetString("uname") == null)
                    {
                        d = "none";
                    }
                    else
                    {
                        d = "block";
                    }
                }
                <div><a href="@Url.Action("Logout", "Admin")" class="nav-link btn btn-sm logout" style="display:@d">Logout</a></div>
            </div>
        </div>
    </nav>

    <div class="my-3 py-3">
        @RenderBody()
    </div>


    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"> </script>

  
</body>
</html>
