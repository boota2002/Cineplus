@model CinePlus.Models.User
@using AspNetCore.ReCaptcha

@{
    Layout = "WithoutSearch";
    ViewData["Title"] = "Register";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body 
    {
        background: white;
    }

    .login-container 
    {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 5rem;
    }
    .login-card 
    {
        background: #fff;
        padding: 3rem 2rem;
        border-radius: 1rem;
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 700px;
    }
    .form-title 
    {
        color: black;
        font-weight: 600;
        text-align: center;
        margin-bottom: 2rem;
    }

    .forgot-password 
    {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.95rem;
        color: black;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .forgot-password:hover 
    {
        text-decoration: underline;
        color: black;
        text-decoration-thickness: 2px;
        text-decoration-color: #F1C202;
    }
    .text-danger, .text-success 
    {
        font-weight: 500;
    }
</style>
<div class="login-container">
    <div class="login-card">
        <h2 class="form-title">Login</h2>
        <form asp-action="Login" method="post" novalidate>
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" />
                @* <span asp-validation-for="Username" class="text-danger"></span> *@
            </div>
            <div class="mb-4">
                <label asp-for="Pass" class="form-label"></label>
                <input asp-for="Pass" type="password" class="form-control" />
                @* <span asp-validation-for="Pass" class="text-danger"></span> *@
                <a href="/User/ForgotPassword" class="forgot-password">Forgot Password?</a>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-warning btn-lg">Login</button>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.err as string))
            {
                <div class="text-danger text-center mt-3">@ViewBag.err</div>
            }
        </form>
    </div>
</div>
