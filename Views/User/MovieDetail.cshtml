<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Movie Details - @ViewBag.name</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f4f6fa;
            margin: 0;
            padding: 0;
        }
        .movie-container {
            max-width: 600px;
            margin: 40px auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.08);
            padding: 32px 40px;
        }
        .movie-title {
            font-size: 2.2rem;
            font-weight: 700;
            color: #2d3748;
            margin-bottom: 12px;
        }
        .movie-meta {
            color: #718096;
            font-size: 1rem;
            margin-bottom: 8px;
        }
        .movie-desc {
            margin-top: 24px;
            font-size: 1.1rem;
            color: #4a5568;
            line-height: 1.6;
        }
        .movie-label {
            font-weight: 600;
            color: #4a5568;
        }
        .movie-info {
            margin-bottom: 6px;
        }
    </style>
</head>
<body>
    <div class="movie-container">
        <div class="movie-title">@ViewBag.name</div>
        <div class="movie-meta movie-info">
            <span class="movie-label">Movie ID:</span> @ViewBag.id
        </div>
        <div class="movie-meta movie-info">
            <span class="movie-label">Duration:</span> @ViewBag.duration
        </div>
        <div class="movie-meta movie-info">
            <span class="movie-label">Release Date:</span> @ViewBag.release
        </div>
        <div class="movie-desc">
            @ViewBag.desc
        </div>
    </div>
    <form method="post">
        <input type="text" value="@ViewBag.id" hidden/>
        <input type="text" value="@ViewBag.name" hidden />
        <input type="submit" value="Book Now"/>
    </form>
</body>
</html>
