@{
    // Add your logo image path here, e.g., ~/images/logo.png
    var logoPath = Url.Content("~/images/logo.png");
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        nav 
        {
            background-color: white;
            padding: 20px;
            font-size: large;
        }

            nav a.dark {
                color: black;
                text-decoration: none;
                margin-right: 4px;
                font-weight: 500;
                padding: 15px;
                border-radius: 4px;
            }
            nav a.dark:hover, nav a.dark:focus 
            {
                text-decoration: underline;
                text-decoration-thickness: 3px;
                text-decoration-color: #F1C202;
            }
    </style>
</head>
<body>
    <div>
        <header>
            <nav class="shadow-sm">
                @{
                    <div style="display:flex; justify-content:space-between; align-items:center; width:100%;">
                        <div style="display:flex; align-items:center;">
                            <img src="/logo.png" alt="Logo" style="height:50px; width:auto;" />
                            <div style="display:flex; align-items:center; margin-inline-start:500px">
                                <a href="@Url.Action("Home","User")" class="dark">Home</a>
                                <a href="@Url.Action("Login","User")" class="dark">Login</a>
                                <a href="@Url.Action("Register","User")" class="dark">Register</a>
                                <a href="@Url.Action("Movies","User")" class="dark">Movies</a>
                            </div>
                        </div>
                        <div style="display:flex; align-items:center;">
                            <form method="post" action="@Url.Action("Movies","User")">
                                <div>
                                    <a href="@Url.Action("LogOut","User")" class="btn btn-warning" style="color:black">Log Out</a>
                                </div>

                            </form>
                        </div>
                    </div>
                }
            </nav>
        </header>
        @RenderBody()
        <footer>
        </footer>
    </div>
</body>
</html>